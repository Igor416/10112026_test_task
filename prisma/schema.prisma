// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LinkType {
  GITHUB
  LINKEDIN
  TELEGRAM
  WEBSITE
  OTHER
}

enum SkillCategory {
  LANGUAGE
  RUNTIME
  FRAMEWORK
  DATABASE
  TOOL
  OTHER
}

model Profile {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String
  links       Link[]
  skills      Skill[]
  experiences Experience[]
  projects    Project[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Link {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type      LinkType
  label     String
  url       String
  sortOrder Int      @default(0)

  @@index([profileId])
}

model Skill {
  id        String        @id @default(cuid())
  profileId String
  profile   Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  category  SkillCategory
  sortOrder Int           @default(0)

  @@unique([profileId, name])
  @@index([profileId])
}

model Experience {
  id           String        @id @default(cuid())
  profileId    String
  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company      String
  position     String
  startDate    DateTime
  endDate      DateTime?
  sortOrder    Int           @default(0)
  achievements Achievement[]

  @@index([profileId])
}

model Achievement {
  id           String     @id @default(cuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  text         String
  sortOrder    Int        @default(0)

  @@index([experienceId])
}

model Project {
  id          String  @id @default(cuid())
  profileId   String
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  url         String
  description String?
  sortOrder   Int     @default(0)

  @@index([profileId])
}
